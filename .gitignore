# VGM Studio .gitignore

# Build directories and outputs
build/
build-*/
bin/
obj/
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
vgmstudio
vgmstudio.exe

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.cmake.in

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Runtime files generated by application
imgui.ini
recent_files.txt

# Scratch scripts, test outputs, temporary dumps
scratch/
*.tmp
*.log
*.wav
__pycache__/
*.pyc

# Extractor binaries
samples/vgm-patch-extractor
